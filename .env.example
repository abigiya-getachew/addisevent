# ------------------------------------------
# 1. DATABASE — PostgreSQL
# ------------------------------------------
# Format: postgresql://username:password@host:port/dbname
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/addisevent

NEXT_PUBLIC_SUPABASE_URL=https://fmmuffqoevsmqdkudtyq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_InRi5c7bOHMEQE08JWWFCA_4k3grSGx
# ------------------------------------------
# 2. CACHE — Redis
# ------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------
# 3. SEARCH — Meilisearch
# ------------------------------------------
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY= # Generate when you first start Meilisearch

# ------------------------------------------
# 4. AUTH — NextAuth / Auth.js v5
# ------------------------------------------
# Generate a strong secret — run: openssl rand -hex 32
AUTH_SECRET=paste_your_long_random_secret_here

# Your local URL
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=localhost:3000

# ------------------------------------------
# 5. PAYMENTS — Telebirr & CBE Birr
# ------------------------------------------
# Get these from your merchant account applications
TELEBIRR_MERCHANT_ID=
TELEBIRR_API_KEY=
TELEBIRR_ENDPOINT=

CBEBIRR_USERNAME=
CBEBIRR_PASSWORD=
CBEBIRR_ENDPOINT=

# Fallback/test payment aggregator
CHAPA_SECRET_KEY=

# ------------------------------------------
# 6. SMS — Ticket Delivery & Notifications
# ------------------------------------------
SMS_PROVIDER=africastalking
SMS_API_KEY=
SMS_SENDER_ID=AddisEvent

# ------------------------------------------
# 7. APPLICATION
# ------------------------------------------
NODE_ENV=development
PORT=3000
API_PORT=5000
API_BASE_URL=http://localhost:5000

# Default language: en or am
NEXT_PUBLIC_DEFAULT_LOCALE=en